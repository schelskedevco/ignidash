{
  "name": "ignidash",
  "version": "0.3.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "dev:convex": "npx convex dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "prepare": "husky",
    "test": "vitest",
    "test:once": "vitest run",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:coverage": "vitest run --coverage --coverage.reporter=text",
    "test:selfhost": "sh scripts/selfhost.test.sh && sh scripts/selfhost.config.test.sh",
    "test:selfhost:e2e": "sh scripts/selfhost.e2e.sh",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "create-demo": "tsx scripts/convert-inputs-json-to-demo-inputs.ts",
    "docker:build": "docker build --target convex-init -t ghcr.io/schelskedevco/ignidash-convex-init:local . && docker build -t ghcr.io/schelskedevco/ignidash:local --build-arg SELF_HOSTED=true --build-arg NEXT_PUBLIC_CONVEX_URL=http://localhost:3210 --build-arg NEXT_PUBLIC_CONVEX_SITE_URL=http://localhost:3211 .",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "selfhost": "sh scripts/selfhost.sh",
    "selfhost:convex-deploy": "docker compose run --rm convex-init"
  },
  "dependencies": {
    "@azure/openai": "^2.0.0",
    "@better-auth/stripe": "~1.7.27",
    "@convex-dev/agent": "^0.7.11",
    "@convex-dev/better-auth": "^0.13.1",
    "@convex-dev/migrations": "^0.3.9",
    "@convex-dev/rate-limiter": "^0.4.3",
    "@convex-dev/resend": "^0.2.10",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@headlessui/react": "^2.2.10",
    "@heroicons/react": "^2.2.0",
    "@hookform/resolvers": "^5.2.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@redux-devtools/extension": "^3.3.0",
    "@vercel/analytics": "^1.6.1",
    "better-auth": "~1.7.27",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "comlink": "^4.4.2",
    "convex": "~1.51.0",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.23.24",
    "immer": "^10.1.1",
    "lucide-react": "^0.525.0",
    "next": "^16.4.6",
    "next-themes": "^0.4.6",
    "openai": "^6.9.1",
    "posthog-js": "^1.453.2",
    "posthog-node": "^5.74.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "react-markdown": "^10.1.0",
    "react-number-format": "^5.4.5",
    "recharts": "^3.11.0",
    "stripe": "^20.1.0",
    "swr": "^2.5.1",
    "tailwind-merge": "^3.7.1",
    "uuid": "^14.0.3",
    "zod": "^4.0.5",
    "zustand": "^5.1.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ],
    "!convex/_generated/**": "echo 'Ignoring generated files'"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@next/bundle-analyzer": "16.4.6",
    "@playwright/test": "^1.65.1",
    "@recharts/devtools": "^0.0.19",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "^4.1.12",
    "convex-test": "^0.0.73",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.1.11",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vite": "^8.3.8",
    "vitest": "^4.1.12",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@ai-sdk/provider-utils": {
      "undici": "^6.29.1"
    },
    "@tailwindcss/typography": {
      "postcss-selector-parser": "^6.1.6"
    }
  }
}
